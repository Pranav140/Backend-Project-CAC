{
  // ✅ Keep IntelliSense keyword suggestions
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.suggest.showWords": true,
  "editor.suggest.showSnippets": false,
  // ❌ Kill inline AI suggestions
  "editor.inlineSuggest.enabled": false,
  // (Optional) prevent snippet spam
  "blackbox.inlineSuggest.enable": false, // for Blackbox AI
  "cybercoder.inlineSuggest.enable": false, // for CyberCoder AI (if present)
}